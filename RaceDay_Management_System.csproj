<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591;CS8981;CS0618;CS8600;CS8601;CS8603;CS0168</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
		<PackageReference Include="System.Data.SqlClient" Version="4.9.1" />
	</ItemGroup>

	<!-- Exclude other projects from this project's compilation -->
	<ItemGroup>
		<Compile Remove="RaceDay_Management_System.Tests\**" />
		<Content Remove="RaceDay_Management_System.Tests\**" />
		<None Remove="RaceDay_Management_System.Tests\**" />
		<EmbeddedResource Remove="RaceDay_Management_System.Tests\**" />

		<Compile Remove="Raceday-Event-Management-System.MVC\**" />
		<Content Remove="Raceday-Event-Management-System.MVC\**" />
		<None Remove="Raceday-Event-Management-System.MVC\**" />
		<EmbeddedResource Remove="Raceday-Event-Management-System.MVC\**" />
	</ItemGroup>

</Project>