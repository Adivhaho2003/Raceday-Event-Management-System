@model Raceday_Event_Management_System.MVC.Models.ViewModels.ManageCategoriesViewModel
@{
    ViewData["Title"] = "Manage Categories";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Categories for: @Model.EventName</h2>
        <a asp-action="ManageEvents" class="btn btn-outline-secondary">Back to Events</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Left Column: Existing Categories -->
        <div class="col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Current Categories</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.LinkedCategories != null && Model.LinkedCategories.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var cat in Model.LinkedCategories)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-0 fw-bold">@cat.CategoryName</h6>
                                        <small class="text-muted">Fee: R @cat.Fee.ToString("F2") | Capacity: @(cat.Capacity?.ToString() ?? "Unlimited")</small>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">No categories linked to this event yet.</div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column: Link New Category -->
        <div class="col-md-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Link a Category</h5>
                </div>
                <div class="card-body">
                    <form asp-action="AddCategory" method="post">
                        <input type="hidden" asp-for="EventId" />
                        <input type="hidden" asp-for="EventName" />

                        <div class="mb-3">
                            <label asp-for="SelectedCategoryId" class="form-label fw-bold">Select Category</label>
                            <select asp-for="SelectedCategoryId" class="form-select" required>
                                <option value="">-- Select a category --</option>
                                @if (Model.AvailableCategories != null)
                                {
                                    @foreach (var cat in Model.AvailableCategories)
                                    {
                                        <option value="@cat.CategoryId">@cat.CategoryName (@cat.CategoryType)</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="SelectedCategoryId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Fee" class="form-label fw-bold">Fee (ZAR)</label>
                            <input asp-for="Fee" class="form-control" type="number" step="0.01" required />
                            <span asp-validation-for="Fee" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Capacity" class="form-label fw-bold">Capacity</label>
                            <input asp-for="Capacity" class="form-control" type="number" required />
                            <span asp-validation-for="Capacity" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-danger w-100 fw-bold">Link Category</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>