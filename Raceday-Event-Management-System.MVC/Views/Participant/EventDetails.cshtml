@model Raceday_Event_Management_System.MVC.Models.ViewModels.EventDetailsViewModel
@{
    ViewData["Title"] = Model.EventName;
}

<div class="container mt-4 mb-5">
    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert" style="border-left: 4px solid #198754 !important;">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0" role="alert" style="border-left: 4px solid #dc3545 !important;">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Event Header -->
    <div class="card shadow-sm border-0 mb-4 overflow-hidden">
        @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
        {
            <img src="@Model.BannerImageUrl" class="card-img-top" alt="@Model.EventName Banner" style="height: 350px; object-fit: cover;">
        }
        else
        {
            <img src="https://images.unsplash.com/photo-1552674605-db6ffd4facb5?q=80&w=2070&auto=format&fit=crop" class="card-img-top" alt="Default Event Banner" style="height: 350px; object-fit: cover;">
        }

        <div class="card-body p-5 text-white" style="background: linear-gradient(135deg, var(--ct-petrol), #1a383c);">
            <div class="d-flex justify-content-between align-items-start flex-wrap">
                <div>
                    <span class="badge mb-3 px-3 py-2 rounded-pill shadow-sm" style="background-color: var(--ct-gold); color: var(--ct-petrol); font-weight: 700; font-size: 0.9rem;">
                        <i class="bi bi-activity me-1"></i>@Model.EventType
                    </span>

                    <h1 class="display-4 fw-bold text-white mb-3" style="text-shadow: 0 2px 4px rgba(0,0,0,0.4);">@Model.EventName</h1>

                    <p class="lead mb-1 text-white fw-medium"><i class="bi bi-geo-alt-fill me-2" style="color: var(--ct-aqua);"></i> @Model.Location</p>
                    <p class="lead text-white fw-medium"><i class="bi bi-calendar-event me-2" style="color: var(--ct-aqua);"></i> @Model.EventDate.ToString("dddd, dd MMMM yyyy")</p>
                </div>
                <div class="text-end d-none d-md-block">
                    <span class="badge bg-success px-3 py-2 fs-6 shadow-sm">@Model.Status</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Left Column: Description -->
        <div class="col-md-7 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4 p-md-5">
                    <h4 class="fw-bold mb-4" style="color: var(--ct-petrol);"><i class="bi bi-info-circle me-2" style="color: var(--ct-aqua);"></i>About this Event</h4>
                    <p class="text-muted" style="line-height: 1.8; font-size: 1.05rem;">
                        @(string.IsNullOrEmpty(Model.Description) ? "No description provided for this event." : Model.Description)
                    </p>

                    <hr class="my-4" style="opacity: 0.1;">

                    <div class="row mt-4">
                        <div class="col-sm-6 mb-3 mb-sm-0">
                            <div class="d-flex align-items-center">
                                <div class="d-flex justify-content-center align-items-center rounded-circle me-3" style="width: 50px; height: 50px; background-color: rgba(0, 180, 216, 0.1); color: var(--ct-aqua);">
                                    <i class="bi bi-rulers fs-4"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Distance</small>
                                    <span class="fw-bold fs-5" style="color: var(--ct-petrol);">@(string.IsNullOrEmpty(Model.Distance) ? "N/A" : Model.Distance)</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center">
                                <div class="d-flex justify-content-center align-items-center rounded-circle me-3" style="width: 50px; height: 50px; background-color: rgba(212, 175, 55, 0.1); color: var(--ct-gold);">
                                    <i class="bi bi-clock-history fs-4"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Event Status</small>
                                    <span class="fw-bold fs-5 text-success">@Model.Status</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Enrolment Logic -->
        <div class="col-md-5 mb-4">
            <div class="card shadow border-0 h-100">
                <div class="card-header py-3 text-center" style="background: linear-gradient(135deg, var(--ct-aqua), #0096c7);">
                    <h4 class="mb-0 fw-bold text-white"><i class="bi bi-ticket-perforated me-2"></i>Event Entry</h4>
                </div>
                <div class="card-body p-4 p-md-5 d-flex flex-column justify-content-center">

                    @if (Context.Session.GetString("Role") == null)
                    {
                        <div class="text-center">
                            <div class="mb-4">
                                <div class="d-inline-flex justify-content-center align-items-center rounded-circle mb-3" style="width: 80px; height: 80px; background-color: rgba(255, 193, 7, 0.1); color: #ffc107;">
                                    <i class="bi bi-person-lock fs-1"></i>
                                </div>
                                <h5 class="fw-bold">Log In Required</h5>
                                <p class="text-muted">You must be logged in as a Participant to enter this event.</p>
                            </div>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary w-100 py-3 fw-bold rounded-pill">Log In to Enrol</a>
                        </div>
                    }
                    else if (Context.Session.GetString("Role") == "Organiser")
                    {
                        <div class="text-center">
                            <div class="mb-4">
                                <div class="d-inline-flex justify-content-center align-items-center rounded-circle mb-3" style="width: 80px; height: 80px; background-color: rgba(108, 117, 125, 0.1); color: #6c757d;">
                                    <i class="bi bi-shield-lock fs-1"></i>
                                </div>
                                <h5 class="fw-bold">Organisers Cannot Enrol</h5>
                                <p class="text-muted">You are currently logged in as an Organiser. Only Participants are allowed to enter events.</p>
                            </div>
                            <a asp-controller="Organiser" asp-action="Dashboard" class="btn btn-outline-secondary w-100 py-3 fw-bold rounded-pill">Go to Dashboard</a>
                        </div>
                    }
                    else if (Model.IsAlreadyEnrolled)
                    {
                        <div class="text-center">
                            <div class="mb-4">
                                <div class="d-inline-flex justify-content-center align-items-center rounded-circle mb-3" style="width: 80px; height: 80px; background-color: rgba(25, 135, 84, 0.1); color: #198754;">
                                    <i class="bi bi-check-circle-fill fs-1"></i>
                                </div>
                                <h5 class="fw-bold">You're In!</h5>
                                <p class="text-muted">You are already enrolled in this event. Good luck with your preparation!</p>
                            </div>
                            <a asp-controller="Participant" asp-action="MyEvents" class="btn btn-success w-100 py-3 fw-bold rounded-pill">View My Events</a>
                        </div>
                    }
                    else
                    {
                        <form asp-controller="Participant" asp-action="Enrol" method="post">
                            <input type="hidden" name="eventId" value="@Model.EventId" />

                            <div class="mb-4">
                                <label class="form-label fw-bold" style="color: var(--ct-petrol);"><i class="bi bi-list-check me-1"></i> Select Category</label>
                                <select name="eventCategoryId" class="form-select form-select-lg shadow-sm" required style="border-radius: 12px; border-color: var(--ct-aqua);">
                                    <option value="">-- Choose a category --</option>
                                    @foreach (var cat in Model.Categories)
                                    {
                                        <option value="@cat.EventCategoryId">
                                            @cat.CategoryName - R @cat.Fee.ToString("F2")
                                        </option>
                                    }
                                </select>
                                <small class="text-muted mt-2 d-block">Select the distance or age group you wish to enter.</small>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold rounded-pill shadow-sm py-3">
                                Confirm Enrolment <i class="bi bi-arrow-right ms-2"></i>
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>