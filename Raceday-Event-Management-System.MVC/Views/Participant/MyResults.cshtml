@model List<Raceday_Event_Management_System.MVC.Models.ViewModels.MyResultViewModel>
@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4">My Race History</h2>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">No results found. Once you complete an event, your results will appear here.</div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover bg-white mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Event</th>
                        <th>Category</th>
                        <th>Finish Time</th>
                        <th>Overall Pos</th>
                        <th>Category Pos</th>
                        <th>Pace</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var res in Model)
                    {
                        <tr>
                            <td class="fw-bold">@res.Event.EventName </td>
                            <td>@res.Category.CategoryName </td>
                            <td>@res.ChipTime </td>
                            <td>@res.OverallPosition </td>
                            <td>@res.CategoryPosition </td>
                            <td>@res.Pace </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>