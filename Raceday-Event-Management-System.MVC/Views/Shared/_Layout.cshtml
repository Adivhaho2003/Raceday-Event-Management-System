<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Raceday_Event_Management_System.MVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-raceday">
            <div class="container-fluid px-4">
                <!-- Logo & Brand -->
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="RaceDay Logo" style="height: 40px; margin-right: 12px; object-fit: contain;" onerror="this.style.display='none'" />
                    <span style="color: white; letter-spacing: -0.5px; font-weight: 700; font-family: 'Poppins';">Race<span style="color: var(--ct-gold);">Day</span></span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
                </button>

                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-compass me-1"></i> Browse Events</a>
                        </li>

                        @if (Context.Session.GetString("Role") == "Participant")
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-controller="Participant" asp-action="MyEvents"><i class="bi bi-ticket-perforated me-1"></i> My Events</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-controller="Participant" asp-action="MyResults"><i class="bi bi-stopwatch me-1"></i> My Results</a>
                            </li>
                        }

                        @if (Context.Session.GetString("Role") == "Organiser")
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-controller="Organiser" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-controller="Organiser" asp-action="ManageEvents"><i class="bi bi-calendar-event me-1"></i> Manage Events</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-center mt-3 mt-lg-0">
                        @if (Context.Session.GetInt32("UserId") != null)
                        {
                            <!-- Profile Avatar Dropdown -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="@(string.IsNullOrEmpty(Context.Session.GetString("ProfilePictureUrl")) ? "/images/default-avatar.png" : Context.Session.GetString("ProfilePictureUrl"))"
                                         alt="Profile" class="nav-avatar me-2" onerror="this.src='/images/default-avatar.png'">
                                    <span class="fw-bold" style="color: white;">@Context.Session.GetString("FirstName")</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="navbarDropdown" style="border-radius: 12px;">
                                    <li>
                                        <a class="dropdown-item py-2 fw-medium" asp-controller="Profile" asp-action="Index">
                                            <i class="bi bi-person-circle me-2" style="color: var(--ct-aqua);"></i> My Profile
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            <button type="submit" class="dropdown-item py-2 text-danger fw-medium"><i class="bi bi-box-arrow-right me-2"></i> Logout</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right me-1"></i> Login</a>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-danger px-4" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- The flex-grow-1 class ensures this takes up all available space, pushing the footer down -->
    <div class="container-fluid px-0 flex-grow-1 d-flex flex-column">
        <main role="main" class="pb-3 flex-grow-1">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            &copy; 2026 - RaceDay Event Management System
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>